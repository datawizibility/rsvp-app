# Local PostgreSQL 17 (D:\PostgreSQL\17). Replace YOUR_PASSWORD.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/rsvp_app_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/rsvp_app_test?schema=public"

# Generate with: npx auth secret
AUTH_SECRET="replace-me"

# Production image uploads (Vercel Blob). Leave blank for local disk in dev.
# Get this from Vercel → Storage → Blob → connect to project.
BLOB_READ_WRITE_TOKEN=""

# WhatsApp Business Cloud API (optional). When set, the bulk sender offers
# official auto-send through approved templates instead of manual deep links.
# Meta app → WhatsApp → API Setup: permanent token + phone number id.
# Template names must be approved in the Meta dashboard first.
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_INVITE="rsvp_invite"
WHATSAPP_TEMPLATE_REMINDER="rsvp_reminder"
WHATSAPP_TEMPLATE_LANG="en"
# Optional: fixed body text used for both templates ({{1}} in the Meta
# template receives this). Leave blank to send the rendered message.
WHATSAPP_TEMPLATE_INVITE_BODY=""
WHATSAPP_TEMPLATE_REMINDER_BODY=""
